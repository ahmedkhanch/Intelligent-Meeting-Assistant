# =============================================================
# CRM Vocal — Environment Variables
# =============================================================
# Copy this file to .env and fill in the values.
# .env is never committed to git.
# =============================================================

# --- DeepSeek API (AI Agent) ---
# Get your key at: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://crm_vocal:crm_vocal@localhost:5432/crm_vocal

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- HubSpot (commercial calls) ---
# Preferred: use a Personal Access Token (PAT) — no OAuth flow needed
# Get yours at: https://app.hubspot.com/settings/private-apps
HUBSPOT_ACCESS_TOKEN=
# OAuth2 (alternative to PAT — Phase 3)
HUBSPOT_CLIENT_SECRET=
HUBSPOT_CLIENT_ID=
HUBSPOT_REFRESH_TOKEN=
HUBSPOT_PORTAL_ID=

# --- VoxTral (Mistral STT — transcription) ---
# Get your key at: https://console.mistral.ai/api-keys
# Batch and realtime use DIFFERENT models:
#   VOXTRAL_MODEL          → batch (upload whole file) — voxtral-mini-latest
#   VOXTRAL_REALTIME_MODEL → realtime streaming — voxtral-mini-transcribe-realtime-2602
VOXTRAL_API_KEY=
VOXTRAL_BASE_URL=https://api.mistral.ai
VOXTRAL_MODEL=voxtral-mini-latest
VOXTRAL_REALTIME_MODEL=voxtral-mini-transcribe-realtime-2602

# --- Ora Studio (tech calls) ---
# Phase 1: leave empty — uses mock client
# Phase 2+: fill with Ora Studio credentials
ORA_STUDIO_API_URL=https://api.ora.studio
ORA_STUDIO_API_KEY=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
